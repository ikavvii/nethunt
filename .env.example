# Server HTTP Port (Default: 3001)
PORT=3001

# Environment Mode: 'production' or 'development'
NODE_ENV=production

# Game Master Admin Passkey (Used for initial setup & admin login)
ADMIN_KEY=login2026admin

# Secret key used for signing alumni authentication JWT tokens
JWT_SECRET=login2026_psg_tech_mca_alumni_nethunt_secret_key_prod

